{
	"name": "adnomina-blog",
	"version": "9.0.0",
	"description": "My personal blog web site using the Eleventy site generator.",
	"type": "module",
	"scripts": {
		"build": "eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 eleventy",
		"build-ghpages": "eleventy",
		"start": "eleventy --serve --quiet",
		"start-ghpages": "eleventy --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* eleventy"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/adnomina/adnomina-blog.git"
	},
	"author": {
		"name": "Nicolas Herschke",
		"email": "nicolas.herschke@gmx.de",
		"url": "https://adnomina.dev"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@11.1.2",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-img": "^6.0.4",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"cross-env": "^10.1.0",
		"luxon": "^3.7.2",
		"prismjs": "^1.30.0",
		"zod": "^3.25.76",
		"zod-validation-error": "^3.5.4"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.0.5"
	}
}
